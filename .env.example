# AI Debate Arena — Environment Variables

# OpenAI
OPENAI_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Optional later
OPENROUTER_API_KEY=

# Deep Debate web search (https://api-dashboard.search.brave.com)
# Free tier: 2,000 queries/month. Also set this in Vercel env vars for production.
BRAVE_SEARCH_API_KEY=
# Optional: which search engine to use (default "brave") and the per-query fee
# shown in the cost HUD (default 0 — set when moving to a paid search tier).
SEARCH_PROVIDER=
SEARCH_COST_USD=
# Optional: "hybrid" routes OpenRouter fighters through their native ":online"
# search (~$0.005/turn) instead of the app-run engine. Default: unified (all
# fighters use the app-run search above).
DEEP_SEARCH_MODE=

# App-level protection for private beta
APP_ACCESS_PASSWORD=

# Cost & abuse protection (per-IP rate limits + daily spend caps). Enforced in
# Postgres via Supabase — run supabase/migrations/0003_rate_limits.sql once.
# All optional; the defaults below apply if unset. Needs Supabase configured.
RL_TURN_PER_MIN=30         # max /api/debate/turn per IP per window (a Blitz match fires 8 in a burst)
RL_VERDICT_PER_MIN=4       # max /api/debate/verdict requests per IP per window
RL_OG_PER_MIN=30           # max /api/og image renders per IP per window
RL_WINDOW_SECONDS=60       # rate-limit window length (seconds)
SPEND_GLOBAL_DAILY_USD=10  # hard daily spend ceiling across ALL users (USD)
SPEND_IP_DAILY_USD=1       # daily spend ceiling per IP (USD)

# Auth + profiles + match persistence (Supabase — see docs/19).
# URL + publishable (anon) key are PUBLIC (row-level security protects data);
# also set these two in Vercel env vars (Production + Preview) for the live site.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY, never expose / never NEXT_PUBLIC. Not needed for v1 (RLS + the
# signed-in user's session cover all reads/writes). Add only if a future
# privileged server task needs it.
SUPABASE_SERVICE_ROLE_KEY=

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signs shareable verdicts so forged /s?d= links show as "unverified" (critical #2).
# Any strong random value (e.g. `openssl rand -hex 32`). Empty disables signing.
SHARE_SECRET=
